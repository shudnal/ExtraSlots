<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ModName>ExtraSlots</ModName>
    <LanguageFileName>Extra Slots.English.json</LanguageFileName>
  </PropertyGroup>

  <Target Name="InitializeExtraSlotsPackageProperties">
    <PropertyGroup>
      <EffectiveModName Condition="'$(ModName)' != ''">$(ModName)</EffectiveModName>
      <EffectiveModName Condition="'$(EffectiveModName)' == '' and '$(TargetName)' != ''">$(TargetName)</EffectiveModName>
      <EffectiveModName Condition="'$(EffectiveModName)' == '' and '$(AssemblyName)' != ''">$(AssemblyName)</EffectiveModName>
      <EffectiveModName Condition="'$(EffectiveModName)' == '' and '$(MSBuildProjectName)' != ''">$(MSBuildProjectName)</EffectiveModName>

      <ResolvedR2ModManProfilePluginsDir Condition="'$(R2ModManProfilePluginsDir)' != ''">$(R2ModManProfilePluginsDir)</ResolvedR2ModManProfilePluginsDir>
      <ResolvedR2ModManProfilePluginsDir Condition="'$(ResolvedR2ModManProfilePluginsDir)' == ''">D:\r2modman\Valheim\profiles\beta\BepInEx\plugins\shudnal-$(EffectiveModName)\</ResolvedR2ModManProfilePluginsDir>

      <ThunderstorePackageDir>$(ProjectDir)package\thunderstore\$(EffectiveModName)\</ThunderstorePackageDir>
      <ThunderstoreZipPath>$(ProjectDir)package\thunderstore\$(EffectiveModName).zip</ThunderstoreZipPath>
      <ThunderstoreManifestPath>$(ThunderstorePackageDir)manifest.json</ThunderstoreManifestPath>

      <NexusPackageRootDir>$(ProjectDir)package\nexus\</NexusPackageRootDir>
      <NexusPackageDir>$(NexusPackageRootDir)$(EffectiveModName)\</NexusPackageDir>
      <NexusZipPath>$(NexusPackageRootDir)$(EffectiveModName).zip</NexusZipPath>
      <NexusManifestPath>$(NexusPackageRootDir)manifest.json</NexusManifestPath>

      <EnglishLocalizationSource>$(ProjectDir)Translations\English.json</EnglishLocalizationSource>
      <ThunderstoreEnglishLocalizationDestination>$(ThunderstorePackageDir)$(LanguageFileName)</ThunderstoreEnglishLocalizationDestination>
      <NexusEnglishLocalizationDestination>$(NexusPackageDir)$(LanguageFileName)</NexusEnglishLocalizationDestination>

      <YamlDotNetAssemblyPath>$(TargetDir)YamlDotNet.dll</YamlDotNetAssemblyPath>
    </PropertyGroup>

    <Error Condition="'$(EffectiveModName)' == ''" Text="Mod name was not resolved. Set &lt;ModName&gt;ExtraSlots&lt;/ModName&gt; in ILRepack.targets." />
    <Error Condition="'$(ThunderstorePackageDir)' == ''" Text="Thunderstore package directory was not resolved." />
    <Error Condition="'$(ThunderstoreZipPath)' == ''" Text="Thunderstore ZIP path was not resolved." />
    <Error Condition="'$(NexusPackageDir)' == ''" Text="Nexus package directory was not resolved." />
    <Error Condition="'$(NexusZipPath)' == ''" Text="Nexus ZIP path was not resolved." />
    <Error Condition="'$(ResolvedR2ModManProfilePluginsDir)' == ''" Text="r2modman profile plugins directory was not resolved." />
  </Target>

  <Target
    Name="UpdateExtraSlotsEmbeddedTranslationsBeforeBuild"
    BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true'">

    <Error Condition="!Exists('$(ProjectDir)UpdateTranslations.ps1')" Text="UpdateTranslations.ps1 was not found in $(ProjectDir)." />
    <Error Condition="!Exists('$(ProjectDir)EmbeddedLocalizations.csv')" Text="EmbeddedLocalizations.csv was not found in $(ProjectDir)." />

    <Exec
      WorkingDirectory="$(ProjectDir)"
      Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(ProjectDir)UpdateTranslations.ps1&quot;" />

    <Message Text="Updated embedded translations before build." Importance="High" />
  </Target>

  <Target
    Name="ReadExtraSlotsPackageVersion"
    DependsOnTargets="InitializeExtraSlotsPackageProperties">

    <Error Condition="!Exists('$(TargetPath)')" Text="Built mod DLL was not found: $(TargetPath)" />

    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="_ExtraSlotsPackageAssemblyIdentity" />
    </GetAssemblyIdentity>

    <PropertyGroup>
      <PackageVersion>%(_ExtraSlotsPackageAssemblyIdentity.Version)</PackageVersion>
    </PropertyGroup>

    <Error Condition="'$(PackageVersion)' == ''" Text="Package version was not resolved from $(TargetPath)." />
    <Message Text="Detected package version from DLL: $(PackageVersion)" Importance="High" />
  </Target>

  <Target
    Name="PrepareExtraSlotsThunderstorePackage"
    DependsOnTargets="ReadExtraSlotsPackageVersion">

    <Error Condition="!Exists('$(EnglishLocalizationSource)')" Text="English localization was not found: $(EnglishLocalizationSource)" />

    <MakeDir Directories="$(ThunderstorePackageDir)" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ThunderstorePackageDir)"
      OverwriteReadOnlyFiles="true" />

    <Copy
      SourceFiles="$(EnglishLocalizationSource)"
      DestinationFiles="$(ThunderstoreEnglishLocalizationDestination)"
      OverwriteReadOnlyFiles="true" />

    <Message Text="Thunderstore package directory updated: $(ThunderstorePackageDir)" Importance="High" />
  </Target>

  <Target
    Name="UpdateExtraSlotsThunderstoreManifest"
    DependsOnTargets="PrepareExtraSlotsThunderstorePackage">

    <Error Condition="!Exists('$(ProjectDir)UpdateThunderstoreManifest.ps1')" Text="UpdateThunderstoreManifest.ps1 was not found in $(ProjectDir)." />
    <Error Condition="!Exists('$(ThunderstoreManifestPath)')" Text="Thunderstore manifest was not found: $(ThunderstoreManifestPath)" />

    <Exec
      WorkingDirectory="$(ProjectDir)"
      Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(ProjectDir)UpdateThunderstoreManifest.ps1&quot; -ManifestPath &quot;$(ThunderstoreManifestPath)&quot; -Version &quot;$(PackageVersion)&quot;" />
  </Target>

  <Target
    Name="ZipExtraSlotsThunderstorePackage"
    DependsOnTargets="UpdateExtraSlotsThunderstoreManifest">

    <ZipDirectory
      SourceDirectory="$(ThunderstorePackageDir)"
      DestinationFile="$(ThunderstoreZipPath)"
      Overwrite="true" />

    <Message Text="Thunderstore archive created: $(ThunderstoreZipPath)" Importance="High" />
  </Target>

  <Target
    Name="CopyExtraSlotsToR2ModMan"
    DependsOnTargets="ZipExtraSlotsThunderstorePackage">

    <MakeDir Directories="$(ResolvedR2ModManProfilePluginsDir)" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ResolvedR2ModManProfilePluginsDir)"
      OverwriteReadOnlyFiles="true" />

    <Message Text="Copied ExtraSlots.dll to r2modman profile: $(ResolvedR2ModManProfilePluginsDir)" Importance="High" />
  </Target>

  <Target
    Name="RepackExtraSlotsForNexus"
    DependsOnTargets="CopyExtraSlotsToR2ModMan">

    <Error Condition="!Exists('$(YamlDotNetAssemblyPath)')" Text="YamlDotNet.dll was not found: $(YamlDotNetAssemblyPath)" />

    <ItemGroup>
      <_ExtraSlotsNexusInputAssemblies Include="$(TargetPath)" />
      <_ExtraSlotsNexusInputAssemblies Include="$(YamlDotNetAssemblyPath)" />
    </ItemGroup>

    <ILRepack
      Parallel="true"
      DebugInfo="true"
      Internalize="true"
      InputAssemblies="@(_ExtraSlotsNexusInputAssemblies)"
      OutputFile="$(TargetPath)"
      TargetKind="SameAsPrimaryAssembly"
      LibraryPath="$(TargetDir)" />

    <Message Text="Repacked ExtraSlots.dll with YamlDotNet for Nexus." Importance="High" />
  </Target>

  <Target
    Name="PrepareExtraSlotsNexusPackage"
    DependsOnTargets="RepackExtraSlotsForNexus">

    <Error Condition="!Exists('$(TargetPath)')" Text="Repacked mod DLL was not found: $(TargetPath)" />
    <Error Condition="!Exists('$(EnglishLocalizationSource)')" Text="English localization was not found: $(EnglishLocalizationSource)" />

    <MakeDir Directories="$(NexusPackageDir)" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(NexusPackageDir)"
      OverwriteReadOnlyFiles="true" />

    <Copy
      SourceFiles="$(EnglishLocalizationSource)"
      DestinationFiles="$(NexusEnglishLocalizationDestination)"
      OverwriteReadOnlyFiles="true" />

    <Message Text="Nexus package directory updated: $(NexusPackageDir)" Importance="High" />
  </Target>

  <Target
    Name="UpdateExtraSlotsNexusManifest"
    DependsOnTargets="PrepareExtraSlotsNexusPackage">

    <Error Condition="!Exists('$(ProjectDir)UpdateNexusManifest.ps1')" Text="UpdateNexusManifest.ps1 was not found in $(ProjectDir)." />
    <Error Condition="!Exists('$(NexusManifestPath)')" Text="Nexus manifest was not found: $(NexusManifestPath)" />

    <Exec
      WorkingDirectory="$(ProjectDir)"
      Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(ProjectDir)UpdateNexusManifest.ps1&quot; -ManifestPath &quot;$(NexusManifestPath)&quot; -Version &quot;$(PackageVersion)&quot; -Name &quot;$(EffectiveModName)&quot;" />
  </Target>

  <Target
    Name="ZipExtraSlotsNexusPackage"
    DependsOnTargets="UpdateExtraSlotsNexusManifest">

    <ZipDirectory
      SourceDirectory="$(NexusPackageDir)"
      DestinationFile="$(NexusZipPath)"
      Overwrite="true" />

    <Message Text="Nexus archive created: $(NexusZipPath)" Importance="High" />
  </Target>

  <Target
    Name="PublishExtraSlotsAfterBuild"
    AfterTargets="Build"
    Condition="'$(DesignTimeBuild)' != 'true'"
    DependsOnTargets="ZipExtraSlotsNexusPackage" />

</Project>
